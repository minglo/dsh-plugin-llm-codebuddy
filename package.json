{
  "name": "dsh-plugin-llm-codebuddy",
  "version": "1.2.1",
  "description": "Tencent CodeBuddy LLM adapter for DeepSeek Harness",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "codebuddy",
    "llm",
    "llm-adapter",
    "deepseek-harness",
    "tencent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minglo/dsh-plugin-llm-codebuddy.git"
  },
  "homepage": "https://github.com/minglo/dsh-plugin-llm-codebuddy#readme",
  "bugs": {
    "url": "https://github.com/minglo/dsh-plugin-llm-codebuddy/issues"
  },
  "author": "Ming Lo <minglo.cn@gmail.com>",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "default": "./dist/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "!dist/**/*.map",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@12.16.1",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "dev:host": "tsdown --watch",
    "dev:client": "tsdown --watch",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.6-alpha.1",
    "eventsource-parser": "^3.1.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.6-alpha.1",
    "@deepseek-ai/dsh-atomic-write": "^0.2.1-rc.2 || ^0.2.2-alpha.0",
    "@deepseek-ai/dsh-credentials": "^0.2.1-rc.2 || ^0.2.2-alpha.0",
    "@deepseek-ai/dsh-home-paths": "^0.2.1-rc.2 || ^0.2.2-alpha.0",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.2 || ^0.2.2-alpha.0",
    "@deepseek-ai/dsh-timeout": "^0.2.1-rc.2 || ^0.2.2-alpha.0",
    "@deepseek-ai/dsh-web": "^0.2.1-rc.2 || ^0.2.2-alpha.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.10",
    "@babel/plugin-proposal-decorators": "8.0.2",
    "@deepseek-ai/cordis": "~4.0.6-alpha.1",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.7-alpha.1",
    "@deepseek-ai/dsh-api-gateway": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-atomic-write": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-authorization": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-store": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-model-selection": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-credentials": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-credentials-local": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-home-paths": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-settings": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-timeout": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-web": "0.2.2-alpha.2",
    "@rolldown/plugin-babel": "0.3.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "~22.20.5",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "jsdom": "^30.1.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "0.23.4",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  },
  "license": "MIT"
}
