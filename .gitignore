# ── dependencies ──────────────────────────────────────────────────────
node_modules/

# ── build output (regenerated by `pnpm build`; shipped via `files`) ───
dist/

# ── package-manager stores & scratch ─────────────────────────────────
.pnpm-store/
*.tgz

# ── local scratch / audit reports ────────────────────────────────────
# dsh-upgrade-audit (npm mode) and hand-run upgrade audits drop their
# materialized trees under tmp/<from>-to-<to>/; never commit those.
tmp/

# ── local development process notes (not part of the plugin) ─────────
docs/superpowers/

# ── agent tooling (vendored skills; build/test never reference these) ─
.agents/
skills-lock.json
opencode.json

# ── agent / editor scratch ───────────────────────────────────────────
.codegraph/
.superpowers/
.DS_Store
*.log
*.tsbuildinfo
*.bak
*.orig
